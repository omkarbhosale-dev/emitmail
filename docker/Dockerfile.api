FROM node:20-alpine AS base

# Install OpenSSL for Prisma engine & curl/wget for healthchecks
RUN apk add --no-cache openssl libc6-compat wget curl
RUN npm install -g pnpm@10

WORKDIR /app

# Stage 1: Install workspace dependencies without running lifecycle scripts before source is copied
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/docs/package.json ./apps/docs/
RUN mkdir -p packages

RUN pnpm install --frozen-lockfile --ignore-scripts

# Stage 2: Build API
COPY apps/api ./apps/api

WORKDIR /app/apps/api
ARG APP_VERSION=1.0.0
ENV APP_VERSION=${APP_VERSION}
RUN npx prisma generate --schema=./prisma/schema.prisma
RUN pnpm build

EXPOSE 4000 2525

# Push DB schema on container boot if needed, then launch API server
CMD ["sh", "-c", "npx prisma db push --schema=./prisma/schema.prisma --skip-generate && pnpm exec tsx prisma/seed.ts && node dist/index.js"]
