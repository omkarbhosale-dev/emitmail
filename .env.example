# ==========================================
# EmitMail Production Configuration (.env)
# ==========================================
# Self-hosted users: Configure this single file at the monorepo root.
# Internal container URLs (DATABASE_URL, REDIS_URL) are wired automatically inside docker-compose.yml.

# App Version & GitHub Repository
APP_VERSION=latest
GITHUB_REPO=omkarbhosale-dev/emitmail

# PostgreSQL Database Credentials
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=
POSTGRES_DB=maildb

# Security Secrets & Keys
# Minimum 32 characters for JWT signing
JWT_SECRET=
# 64-character hex string (32 bytes) for AES-256-GCM DKIM key encryption
ENCRYPTION_KEY=
# Internal shared secret for the updater sidecar service
UPDATER_SECRET=
# Generated by install.sh; required for first-time admin setup (minimum 16 characters)
INITIAL_ADMIN_PASSWORD=
# Optional test workflow credential; use a separate value from INITIAL_ADMIN_PASSWORD
TEST_ADMIN_PASSWORD=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Host Port Bindings (binds to 127.0.0.1 for web services, 0.0.0.0 for SMTP)
DASHBOARD_PORT=3000
API_PORT=4000
DOCS_PORT=3001
SMTP_SUBMISSION_PORT=2525
SMTP_RELAY_PORT=25

# Mail Server & Primary Sending Domain Configuration
# Note: You DO NOT need to configure these here manually! When you first log in to the Dashboard,
# an interactive 2-step Onboarding Setup Wizard will automatically detect your VPS public IP,
# prompt for your domain, and auto-provision your 2048-bit DKIM, SPF, DMARC, and MX records.
# Optional fallback overrides:
# MAIL_SERVER_HOSTNAME=mail.example.com
# VPS_PUBLIC_IPV4=0.0.0.0
# SMTP_EHLO_HOSTNAME=mail.example.com
# SENDING_SERVER_IP=0.0.0.0
# RETURN_PATH_SUBDOMAIN=send
# SPF_INCLUDE_DOMAIN=_spf.example.com

# Inbound SMTP Receiver Engine
INBOUND_SMTP_ENABLED=true
INBOUND_SMTP_PORT=2525
INBOUND_SMTP_HOST=0.0.0.0
INBOUND_MAX_BYTES=26214400
