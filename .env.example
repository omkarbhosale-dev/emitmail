# ==========================================
# EmitMail Monorepo Configuration (.env)
# ==========================================
# Self-hosted users: Configure this single file at the monorepo root.
# Do NOT create or maintain individual .env files inside apps/ or packages/.

# Environment
NODE_ENV=development

# Service Ports & URLs
PORT=4000
API_PORT=4000
DASHBOARD_PORT=3000
DOCS_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL Database
POSTGRES_USER=emitmail
POSTGRES_PASSWORD=emitmail_pass
POSTGRES_DB=emitmail
DATABASE_URL=postgresql://emitmail:emitmail_pass@localhost:5432/emitmail?schema=public

# Redis Broker / Cache
REDIS_PASSWORD=emitmail_redis_pass
REDIS_URL=redis://localhost:6379

# Security & Secrets
# Minimum 32 characters for JWT signing
JWT_SECRET=emitmail_super_secret_jwt_key_change_in_prod_2026

# AES-256-GCM 32-byte encryption key as 64-character hex string for DKIM private keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Master Self-Hosted Mail Server Configuration (Replace with your VPS hostname and IP)
SMTP_EHLO_HOSTNAME=mail.yourdomain.com
SENDING_SERVER_IP=198.51.100.1
RETURN_PATH_SUBDOMAIN=send
MAIL_SERVER_HOSTNAME=mail.yourdomain.com
SPF_INCLUDE_DOMAIN=_spf.yourdomain.com
VPS_PUBLIC_IPV4=198.51.100.1

# Inbound SMTP Receiver & Mailbox Engine
INBOUND_SMTP_ENABLED=true
INBOUND_SMTP_PORT=2525
INBOUND_SMTP_HOST=0.0.0.0
INBOUND_MAX_BYTES=26214400
# INBOUND_TLS_KEY_PATH=/etc/letsencrypt/live/mail.yourdomain.com/privkey.pem
# INBOUND_TLS_CERT_PATH=/etc/letsencrypt/live/mail.yourdomain.com/fullchain.pem
